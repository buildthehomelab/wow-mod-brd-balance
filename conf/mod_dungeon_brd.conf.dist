[worldserver]

########################################
# mod-dungeon-brd
#
# Balance tweaks for Blackrock Depths.
########################################

#
#    DungeonBrd.Enable
#        Description: Master switch.
#        Default:     1
#

DungeonBrd.Enable = 1

#
#    DungeonBrd.MinRespawnSeconds
#        Description: Minimum respawn time (seconds) for creatures spawned in Blackrock Depths.
#                     Stock AzerothCore has the Lyceum's ~200 Anvilrage Reservists on 0 (back
#                     when the corpse decays, about 1 minute) and the Shadowforge Flame Keepers on
#                     5 minutes, while the rest of BRD's trash uses 7200. The default puts the
#                     Reservists on the Flame Keepers' 5 minutes, so the room still refills behind
#                     a slow group. Longer spawn times are never shortened. 0 turns this off.
#        Default:     300
#

DungeonBrd.MinRespawnSeconds = 300

#
#    DungeonBrd.IgnoreEntries
#        Description: Comma-separated creature entries that keep their stock respawn time.
#                     Default: Hurley Blackbreath (9537) and Blackbreath Crony (9541) from the
#                     Grim Guzzler event, and the Brewfest Dark Iron Brewer (28067).
#        Default:     "9537,9541,28067"
#

DungeonBrd.IgnoreEntries = "9537,9541,28067"

#
#    DungeonBrd.IronHallFlameWidth
#        Description: Width (yards) of each Ironhand Guardian's Gout of Flame during Magmus. Stock
#                     AzerothCore hits everything within 30 yards of every statue, which covers
#                     the whole Iron Hall. With a width set, each statue only burns a strip straight
#                     out in front of it (still 30 yards long), so the gaps between the rows of
#                     statues are safe. 0 keeps the stock 30-yard circle. Either way the statues
#                     stop once Magmus is dead (stock leaves them firing for the rest of the run).
#        Default:     10
#

DungeonBrd.IronHallFlameWidth = 10
